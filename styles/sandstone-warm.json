{
    "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
    "version": 3,
    "title": "Sandstone Warm",
    "settings": {
        "color": {
            "palette": [
                {
                    "slug": "primary",
                    "name": "Terra Cotta",
                    "color": "#9b4a2c"
                },
                {
                    "slug": "primary-accent",
                    "name": "Terra Wash",
                    "color": "#e6d4c7"
                },
                {
                    "slug": "primary-alt",
                    "name": "Terra Muted",
                    "color": "#b87a5e"
                },
                {
                    "slug": "primary-alt-accent",
                    "name": "Charcoal",
                    "color": "#52412f"
                },
                {
                    "slug": "main",
                    "name": "Ink",
                    "color": "#3b2f24"
                },
                {
                    "slug": "main-accent",
                    "name": "Ink Wash",
                    "color": "#dcd4c9"
                },
                {
                    "slug": "base",
                    "name": "Parchment",
                    "color": "#f2ebe0"
                },
                {
                    "slug": "secondary",
                    "name": "Ink Light",
                    "color": "#6d5d4e"
                },
                {
                    "slug": "tertiary",
                    "name": "Parchment Dark",
                    "color": "#e6daca"
                },
                {
                    "slug": "border-light",
                    "name": "Ink Ghost",
                    "color": "#d4c8b5"
                },
                {
                    "slug": "border-dark",
                    "name": "Ink Faint",
                    "color": "#8e7d6c"
                }
            ]
        },
        "custom": {
            "borderLight": "rgba(212, 200, 181, 0.5)",
            "borderFrame": "rgba(109, 93, 78, 0.15)",
            "dotGrid": "rgba(150, 135, 115, 0.22)",
            "gridLine": "rgba(170, 155, 135, 0.15)",
            "vellumEdge": "rgba(242, 235, 224, 0.6)",
            "terraTint": "rgba(155, 74, 44, 0.25)",
            "logoFilter": "brightness(0) contrast(1.05) drop-shadow(0 0 0.4px rgba(59, 47, 36, 0.9))"
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--main)"
        },
        "elements": {
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--main)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--secondary)"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "transparent",
                    "text": "var(--wp--preset--color--main)"
                },
                "border": {
                    "color": "var(--wp--preset--color--border-light)"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--main)",
                        "text": "var(--wp--preset--color--base)"
                    },
                    "border": {
                        "color": "var(--wp--preset--color--main)"
                    }
                }
            }
        },
        "blocks": {
            "core/separator": {
                "color": {
                    "text": "var(--wp--preset--color--border-light)"
                },
                "border": {
                    "color": "var(--wp--preset--color--border-light)"
                }
            },
            "core/quote": {
                "color": {
                    "text": "var(--wp--preset--color--secondary)"
                },
                "border": {
                    "left": {
                        "color": "var(--wp--preset--color--primary)"
                    }
                }
            }
        }
    }
}
