{
    "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
    "version": 3,
    "title": "Charcoal Blueprint",
    "settings": {
        "color": {
            "palette": [
                {
                    "slug": "primary",
                    "name": "Terra Cotta",
                    "color": "#d4785e"
                },
                {
                    "slug": "primary-accent",
                    "name": "Terra Wash",
                    "color": "#372a24"
                },
                {
                    "slug": "primary-alt",
                    "name": "Terra Muted",
                    "color": "#e09880"
                },
                {
                    "slug": "primary-alt-accent",
                    "name": "Charcoal",
                    "color": "#2a2825"
                },
                {
                    "slug": "main",
                    "name": "Ink",
                    "color": "#e8e3d8"
                },
                {
                    "slug": "main-accent",
                    "name": "Ink Wash",
                    "color": "#363532"
                },
                {
                    "slug": "base",
                    "name": "Parchment",
                    "color": "#1e1d1b"
                },
                {
                    "slug": "secondary",
                    "name": "Ink Light",
                    "color": "#b5ae9f"
                },
                {
                    "slug": "tertiary",
                    "name": "Parchment Dark",
                    "color": "#161513"
                },
                {
                    "slug": "border-light",
                    "name": "Ink Ghost",
                    "color": "#3a3733"
                },
                {
                    "slug": "border-dark",
                    "name": "Ink Faint",
                    "color": "#8d8780"
                }
            ]
        },
        "custom": {
            "borderLight": "rgba(58, 55, 51, 0.5)",
            "borderFrame": "rgba(200, 195, 185, 0.15)",
            "dotGrid": "rgba(100, 95, 85, 0.22)",
            "gridLine": "rgba(80, 75, 68, 0.15)",
            "vellumEdge": "rgba(30, 29, 27, 0.6)",
            "terraTint": "rgba(212, 120, 94, 0.25)",
            "logoFilter": "brightness(0) invert(1)"
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--main)"
        },
        "elements": {
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--main)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--secondary)"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "transparent",
                    "text": "var(--wp--preset--color--main)"
                },
                "border": {
                    "color": "var(--wp--preset--color--border-light)"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--main)",
                        "text": "var(--wp--preset--color--base)"
                    },
                    "border": {
                        "color": "var(--wp--preset--color--main)"
                    }
                }
            }
        },
        "blocks": {
            "core/separator": {
                "color": {
                    "text": "var(--wp--preset--color--border-light)"
                },
                "border": {
                    "color": "var(--wp--preset--color--border-light)"
                }
            },
            "core/quote": {
                "color": {
                    "text": "var(--wp--preset--color--secondary)"
                },
                "border": {
                    "left": {
                        "color": "var(--wp--preset--color--primary)"
                    }
                }
            },
            "core/search": {
                "color": {
                    "text": "var(--wp--preset--color--main)"
                },
                "elements": {
                    "button": {
                        "color": {
                            "background": "var(--wp--preset--color--main)",
                            "text": "var(--wp--preset--color--base)"
                        },
                        "border": {
                            "color": "var(--wp--preset--color--main)",
                            "width": "1px",
                            "style": "solid"
                        },
                        ":hover": {
                            "color": {
                                "background": "var(--wp--preset--color--primary)",
                                "text": "var(--wp--preset--color--base)"
                            },
                            "border": {
                                "color": "var(--wp--preset--color--primary)"
                            }
                        }
                    }
                }
            }
        }
    }
}
