{
    "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
    "version": 3,
    "title": "Drafting Blue",
    "settings": {
        "color": {
            "palette": [
                {
                    "slug": "primary",
                    "name": "Terra Cotta",
                    "color": "#2d5f8a"
                },
                {
                    "slug": "primary-accent",
                    "name": "Terra Wash",
                    "color": "#d3dde7"
                },
                {
                    "slug": "primary-alt",
                    "name": "Terra Muted",
                    "color": "#5a8ab5"
                },
                {
                    "slug": "primary-alt-accent",
                    "name": "Charcoal",
                    "color": "#2a3d52"
                },
                {
                    "slug": "main",
                    "name": "Ink",
                    "color": "#1a2a3a"
                },
                {
                    "slug": "main-accent",
                    "name": "Ink Wash",
                    "color": "#d5dadf"
                },
                {
                    "slug": "base",
                    "name": "Parchment",
                    "color": "#eef2f6"
                },
                {
                    "slug": "secondary",
                    "name": "Ink Light",
                    "color": "#4a6178"
                },
                {
                    "slug": "tertiary",
                    "name": "Parchment Dark",
                    "color": "#dfe6ed"
                },
                {
                    "slug": "border-light",
                    "name": "Ink Ghost",
                    "color": "#c4d0dc"
                },
                {
                    "slug": "border-dark",
                    "name": "Ink Faint",
                    "color": "#7a9bb5"
                }
            ]
        },
        "custom": {
            "borderLight": "rgba(196, 208, 220, 0.5)",
            "borderFrame": "rgba(74, 97, 120, 0.15)",
            "dotGrid": "rgba(100, 130, 160, 0.22)",
            "gridLine": "rgba(120, 150, 180, 0.15)",
            "vellumEdge": "rgba(238, 242, 246, 0.6)",
            "terraTint": "rgba(45, 95, 138, 0.25)"
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--main)"
        },
        "elements": {
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--main)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--secondary)"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "transparent",
                    "text": "var(--wp--preset--color--main)"
                },
                "border": {
                    "color": "var(--wp--preset--color--border-light)"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--main)",
                        "text": "var(--wp--preset--color--base)"
                    },
                    "border": {
                        "color": "var(--wp--preset--color--main)"
                    }
                }
            }
        },
        "blocks": {
            "core/separator": {
                "color": {
                    "text": "var(--wp--preset--color--border-light)"
                },
                "border": {
                    "color": "var(--wp--preset--color--border-light)"
                }
            },
            "core/quote": {
                "color": {
                    "text": "var(--wp--preset--color--secondary)"
                },
                "border": {
                    "left": {
                        "color": "var(--wp--preset--color--primary)"
                    }
                }
            }
        }
    }
}
